# ---------------------------------------------------------------
# Workora – environment variables
# Copy to .env.local for local development. On Vercel add the same names
# in: Project → Settings → Environment Variables.  NEVER commit real values.
# ---------------------------------------------------------------

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
# Database name (used when the URI has no /dbname part)
MONGODB_DB=workora

# Session signing secret – at least 32 characters, different for every environment.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Optional invite code required on the very first registration (recommended on a public URL)
REGISTRATION_KEY=

# Optional: token that enables  GET /api/setup?token=...  (creates collections + indexes). Remove after use if you like.
SETUP_TOKEN=

# Keep self-registration open after the first workspace exists (default: closed)
# ALLOW_PUBLIC_REGISTRATION=true

# Sign-up requests (user enters e-mail, owner approves, then can log in):
# which e-mail domains may request access. Default: gmail.com. Comma separated; empty = any e-mail.
# SIGNUP_ALLOWED_DOMAINS=gmail.com

# E-mail ("your request was approved"). Gmail example – needs 2-step verification + an App Password
# (Google Account → Security → App passwords). Without these, no e-mail is sent.
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# MAIL_FROM=Workora <yourname@gmail.com>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Public address of the site (used for the login link in e-mails). Default: the address of the request.
# APP_URL=https://your-project.vercel.app

# Time zone used for dates (client + server)
NEXT_PUBLIC_APP_TIMEZONE=Asia/Tehran
APP_TIMEZONE=Asia/Tehran

# Vercel / serverless: WebSockets are not available → use polling for chat + notifications.
# (Leave unset when running `npm run dev` / `npm start` on your own server to use WebSocket.)
# NEXT_PUBLIC_REALTIME=polling

# Push notifications (installed app / browser notifications).
# Optional: without these, a key pair is generated once and stored in MongoDB.
# Recommended for production – generate with:  npm run vapid
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
