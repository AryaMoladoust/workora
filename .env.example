# ---------------------------------------------------------------
# Workora – environment variables
# Copy to .env.local for local development. On Vercel add the same names
# in: Project → Settings → Environment Variables.  NEVER commit real values.
# ---------------------------------------------------------------

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
# Database name (used when the URI has no /dbname part)
MONGODB_DB=workora

# Session signing secret – at least 32 characters, different for every environment.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Optional invite code required on the very first registration (recommended on a public URL)
REGISTRATION_KEY=

# Optional: token that enables  GET /api/setup?token=...  (creates collections + indexes). Remove after use if you like.
SETUP_TOKEN=

# Keep self-registration open after the first workspace exists (default: closed)
# ALLOW_PUBLIC_REGISTRATION=true

# Time zone used for dates (client + server)
NEXT_PUBLIC_APP_TIMEZONE=Asia/Tehran
APP_TIMEZONE=Asia/Tehran

# Vercel / serverless: WebSockets are not available → use polling for chat + notifications.
# (Leave unset when running `npm run dev` / `npm start` on your own server to use WebSocket.)
# NEXT_PUBLIC_REALTIME=polling
